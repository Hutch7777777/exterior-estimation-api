# Server
PORT=3000
NODE_ENV=production

# Inbound authentication from n8n. Railway requires this by default.
ESTIMATION_API_KEY=replace_with_a_long_random_value
ESTIMATION_REQUIRE_API_KEY=true

# Supabase (get from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
